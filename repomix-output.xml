.conversations-tabs {
  display: flex;
  border-bottom: 2px solid #e9ecef;
  background: white;
}

.conversations-tabs .tab {
  flex: 1;
  padding: 1rem;
  border: none;
  background: transparent;
  cursor: pointer;
  font-size: 0.9rem;
  color: #6c757d;
