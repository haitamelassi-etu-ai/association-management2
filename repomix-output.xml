  padding: 10px 12px;
  border: 2px solid var(--border-color, #e0e0e0);
  border-radius: 8px;
  font-size: 14px;
  background: var(--input-bg, #f8f9fa);
  transition: all 0.2s;
}

.filter-item input:focus,
.filter-item select:focus {
