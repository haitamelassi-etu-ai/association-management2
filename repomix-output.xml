    grid-template-columns: 1fr;
  }

  .modal-content {
    width: 95%;
    margin: 10px;
    max-height: 95vh;
    border-radius: 15px;
  }

  .modal-header {
    padding: 18px 20px;
    border-radius: 15px 15px 0 0;
  }

  .modal-header h2 {
    font-size: 1.2rem;
  }

  .stock-form,
  .consume-form {
    padding: 18px;
  }

  .modal-actions {
    flex-direction: column;
  }

  .modal-actions .btn-cancel,
  .modal-actions .btn-submit {
    width: 100%;
    text-align: center;
  }

  /* Summary cards */
  .stock-summary {
    padding: 15px;
    margin-top: 15px;
  }

  .summary-cards {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .summary-value {
