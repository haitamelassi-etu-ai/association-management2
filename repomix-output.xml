  --pro-gold: #caa24a;
  --pro-gold-soft: #f0d489;
  --pro-cream: #f7f3ea;
  --pro-paper: #fffdf8;
  --pro-line: rgba(37, 35, 31, 0.12);
  --pro-shadow: 0 18px 45px rgba(34, 29, 18, 0.08);
  --pro-danger: #b82920;
  --pro-success: #2d7a56;
  --pro-info: #315f9f;
  --pro-radius: 8px;
  --pro-font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --pro-font-serif: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;

