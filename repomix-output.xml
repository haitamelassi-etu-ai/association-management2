<file path="src/components/MealDistribution.css">
.meal-distribution {
  padding: 2rem;
  max-width: 1600px;
  margin: 0 auto;
}

.meal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  flex-wrap: wrap;
  gap: 1rem;
}

.meal-header h2 {
  font-size: 2.5rem;
  color: var(--primary-color);
  margin: 0;
}

.meal-subtitle {
  color: var(--text-secondary);
  margin-top: 0.5rem;
}

.meal-header-actions {
  display: flex;
  gap: 1rem;
  align-items: center;
  flex-wrap: wrap;
}

.date-input, .meal-type-select {
  padding: 0.75rem 1rem;
  border: 2px solid var(--border-color);
  border-radius: 8px;
  background: var(--card-bg);
  color: var(--text-color);
  font-size: 1rem;
  transition: all 0.3s ease;
}

.date-input:focus, .meal-type-select:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.btn-add {
  padding: 0.75rem 1.5rem;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-add:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
}

.meal-message {
  padding: 1rem 1.5rem;
  border-radius: 8px;
  margin-bottom: 2rem;
  animation: slideDown 0.3s ease;
}

.meal-message.success {
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
  border-left: 4px solid #4caf50;
  color: #2e7d32;
}

.meal-message.error {
  background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
  border-left: 4px solid #f44336;
  color: #c62828;
}

/* Statistics */
.meal-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.stat-card-mini {
  background: var(--card-bg);
  padding: 1.5rem;
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 1rem;
  border: 2px solid var(--border-color);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.stat-card-mini:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
}

.stat-card-mini .stat-icon {
  font-size: 2.5rem;
}

.stat-card-mini .stat-value {
  font-size: 2rem;
  font-weight: bold;
  color: var(--primary-color);
}

.stat-card-mini .stat-label {
  color: var(--text-secondary);
  font-size: 0.9rem;
}

.stat-card-mini.total { border-color: #667eea; }
.stat-card-mini.served { border-color: #4caf50; }
.stat-card-mini.pending { border-color: #ff9800; }
.stat-card-mini.cost { border-color: #e91e63; }

/* Quick Actions */
.quick-actions {
  background: var(--card-bg);
  padding: 2rem;
  border-radius: 12px;
  margin-bottom: 2rem;
  border: 2px solid var(--border-color);
}

.quick-actions h3 {
  color: var(--primary-color);
  margin-bottom: 1rem;
}

.action-buttons {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
}

.action-btn {
  padding: 1rem;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

.action-btn.daily-plan {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  font-size: 16px;
  padding: 1.2rem;
  box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
  grid-column: 1 / -1;
}

.action-btn.daily-plan:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 6px 25px rgba(102, 126, 234, 0.5);
}

.action-btn:hover:not(:disabled) {
  transform: scale(1.05);
  box-shadow: 0 6px 20px rgba(245, 87, 108, 0.4);
}

.action-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Meals List */
.meals-list {
  margin-top: 2rem;
}

.loading-spinner {
  text-align: center;
  padding: 3rem;
  font-size: 1.5rem;
  color: var(--text-secondary);
}

.empty-state {
  text-align: center;
  padding: 4rem 2rem;
}

.empty-icon {
  font-size: 5rem;
  margin-bottom: 1rem;
}

.empty-state p {
  color: var(--text-secondary);
  font-size: 1.2rem;
}

.meals-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 1.5rem;
}

.meal-card {
  background: var(--card-bg);
  border: 2px solid var(--border-color);
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.3s ease;
}

.meal-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
}

.meal-card.served {
  border-left: 4px solid #4caf50;
}

.meal-card.pending {
  border-left: 4px solid #ff9800;
}

.meal-card-header {
  padding: 1rem;
  background: var(--bg-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2px solid var(--border-color);
}

.meal-type-badge {
  font-weight: 600;
  font-size: 1rem;
}

.status-badge {
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 600;
}

.status-badge.served {
  background: #e8f5e9;
  color: #2e7d32;
}

.status-badge.pending {
  background: #fff3e0;
  color: #e65100;
}

.meal-card-body {
  padding: 1.5rem;
}

.beneficiary-info {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1rem;
}

.beneficiary-avatar {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 1.2rem;
}

.beneficiary-name {
  font-weight: 600;
  color: var(--text-color);
}

.beneficiary-cin {
  font-size: 0.85rem;
  color: var(--text-secondary);
}

.menu-items {
  padding: 0.75rem;
  background: var(--bg-color);
  border-radius: 6px;
  margin: 1rem 0;
  font-size: 0.9rem;
  color: var(--text-secondary);
}

.special-diet {
  padding: 0.5rem 0.75rem;
  background: #fff3e0;
  border-radius: 6px;
  color: #e65100;
  font-size: 0.85rem;
  margin: 0.5rem 0;
  display: inline-block;
}

.meal-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border-color);
  font-size: 0.9rem;
  color: var(--text-secondary);
}

.served-info {
  margin-top: 1rem;
  padding: 0.75rem;
  background: #e8f5e9;
  border-radius: 6px;
}

.served-info small {
  color: #2e7d32;
  font-size: 0.85rem;
}

.meal-card-footer {
  padding: 1rem;
  background: var(--bg-color);
  border-top: 2px solid var(--border-color);
}

.btn-serve {
  width: 100%;
  padding: 0.75rem;
  background: linear-gradient(135deg, #4caf50 0%, #66bb6a 100%);
  color: white;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-serve:hover {
  transform: scale(1.02);
  box-shadow: 0 4px 12px rgba(76, 175, 80, 0.4);
}

/* Modal */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.3s ease;
}

.modal-content {
  background: var(--card-bg);
  border-radius: 12px;
  max-width: 600px;
  width: 90%;
  max-height: 90vh;
  overflow-y: auto;
  animation: slideUp 0.3s ease;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem;
  border-bottom: 2px solid var(--border-color);
}

.modal-header h3 {
  margin: 0;
  color: var(--primary-color);
}

.modal-close {
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: var(--text-secondary);
  padding: 0.25rem 0.5rem;
}

.modal-close:hover {
  color: var(--text-color);
}

.meal-form {
  padding: 1.5rem;
}

.form-group {
  margin-bottom: 1.5rem;
}

.form-group label {
  display: block;
  margin-bottom: 0.5rem;
  font-weight: 600;
  color: var(--text-color);
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 0.75rem;
  border: 2px solid var(--border-color);
  border-radius: 8px;
  background: var(--bg-color);
  color: var(--text-color);
  font-size: 1rem;
  transition: all 0.3s ease;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.modal-actions {
  display: flex;
  gap: 1rem;
  justify-content: flex-end;
  padding-top: 1rem;
  border-top: 2px solid var(--border-color);
}

.btn-cancel, .btn-submit {
  padding: 0.75rem 2rem;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-cancel {
  background: var(--bg-color);
  border: 2px solid var(--border-color);
  color: var(--text-color);
}

.btn-cancel:hover {
  background: var(--border-color);
}

.btn-submit {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: none;
  color: white;
}

.btn-submit:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
}

.btn-submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(50px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* RTL Support */
[dir='rtl'] .meal-message {
  border-left: none;
  border-right: 4px solid;
}

[dir='rtl'] .meal-card.served {
  border-left: none;
  border-right: 4px solid #4caf50;
}

[dir='rtl'] .meal-card.pending {
  border-left: none;
  border-right: 4px solid #ff9800;
}

/* Dark Mode */
[data-theme='dark'] .meal-message.success {
  background: linear-gradient(135deg, #1b5e20 0%, #2e7d32 100%);
  color: #a5d6a7;
}

[data-theme='dark'] .meal-message.error {
  background: linear-gradient(135deg, #b71c1c 0%, #c62828 100%);
  color: #ef9a9a;
}

[data-theme='dark'] .special-diet {
  background: #3e2723;
  color: #ffb74d;
}

[data-theme='dark'] .served-info {
  background: #1b5e20;
}

[data-theme='dark'] .served-info small {
  color: #a5d6a7;
}

/* Responsive */
@media (max-width: 768px) {
  .meal-distribution {
    padding: 1rem;
  }

  .meal-header {
    flex-direction: column;
    align-items: stretch;
  }

  .meal-header-actions {
    flex-direction: column;
  }

  .meal-stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .meals-grid {
    grid-template-columns: 1fr;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .modal-actions {
    flex-direction: column;
  }

  .btn-cancel, .btn-submit {
    width: 100%;
  }
}
