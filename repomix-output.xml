    opacity: 1;
    transform: translateY(0);
  }
}

.export-header {
  padding: 16px 20px;
  border-bottom: 1px solid var(--border-color, #e0e0e0);
}

.export-header h4 {
  margin: 0;
  font-size: 16px;
