  }

  .type-btn {
    padding: 12px;
    font-size: 0.95rem;
  }

  .current-stock-info {
    padding: 12px 15px;
  }

  .info-value {
    font-size: 1.2rem;
  }

  .plan-content {
    padding: 18px;
  }
}

/* ══════════════════════════════════════════════ */
/* RESPONSIVE — Phones (max-width: 576px)        */
/* Table → Card layout                           */
/* ══════════════════════════════════════════════ */
@media (max-width: 576px) {
  .food-stock-container {
    padding: 8px;
  }

  .food-stock-header {
    padding: 12px;
    border-radius: 12px;
    margin-bottom: 15px;
  }

  .food-stock-header h1 {
    font-size: 1.15rem;
  }

  .header-actions {
    gap: 6px;
  }

  .header-actions button {
    padding: 8px 10px;
    font-size: 0.78rem;
    border-radius: 6px;
    min-width: 0;
  }

  .stats-grid {
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 15px;
  }

  .stat-card {
    padding: 12px 10px;
    gap: 8px;
    border-radius: 10px;
    flex-direction: column;
    text-align: center;
  }

  .stat-icon {
    font-size: 1.6rem;
  }

  .stat-content h3 {
    font-size: 1.2rem;
  }

  .stat-content p {
    font-size: 0.75rem;
  }

  /* ── Table → Cards ── */
  .stock-table-container {
    padding: 10px;
    border-radius: 12px;
  }

  .stock-table thead {
    display: none;
  }

  .stock-table,
  .stock-table tbody,
  .stock-table tr,
  .stock-table td {
    display: block;
    width: 100%;
  }

  .stock-table tbody tr {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    margin-bottom: 12px;
    padding: 14px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: box-shadow 0.2s;
  }

  .stock-table tbody tr:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  .stock-table td {
    padding: 6px 0;
    border-bottom: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.88rem;
  }

  .stock-table td::before {
    content: attr(data-label);
    font-weight: 700;
    color: #667eea;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    min-width: 100px;
    flex-shrink: 0;
  }

  /* First td (name) — make it stand out as card title */
  .stock-table td:first-child {
    flex-direction: column;
    align-items: flex-start;
    padding-bottom: 10px;
    margin-bottom: 6px;
    border-bottom: 2px solid #f0f0f0;
  }

  .stock-table td:first-child::before {
    display: none;
  }

  .stock-table td:first-child strong {
    font-size: 1.05rem;
    color: #2d3748;
  }

  /* Last td (actions) — full width centered */
  .stock-table td:last-child {
    justify-content: center;
    padding-top: 10px;
    margin-top: 6px;
    border-top: 2px solid #f0f0f0;
  }

  .stock-table td:last-child::before {
    display: none;
  }

  .action-buttons {
    gap: 6px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-action {
    font-size: 1.2rem;
    padding: 8px 10px;
    border-radius: 8px;
    background: #f7fafc;
    border: 1px solid #e2e8f0;
  }

  /* Summary */
  .stock-summary {
    padding: 12px;
    margin-top: 12px;
    border-radius: 12px;
  }

  .stock-summary h3 {
    font-size: 1.1rem;
    margin-bottom: 12px;
  }

  .summary-cards {
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .summary-card {
    padding: 14px 10px;
    border-radius: 10px;
  }

  .summary-value {
    font-size: 1.3rem;
  }

  .summary-label {
    font-size: 0.72rem;
  }

  /* Modal adjustments for small screens */
  .modal-overlay {
    align-items: flex-end;
    padding: 0;
  }

  .modal-content {
    width: 100%;
    max-height: 92vh;
    border-radius: 20px 20px 0 0;
    margin: 0;
  }

  .modal-content.small {
    max-width: 100%;
  }

  .modal-header {
    border-radius: 20px 20px 0 0;
    padding: 16px 18px;
  }

  .modal-header h2 {
    font-size: 1.1rem;
  }

  .stock-form,
  .consume-form {
    padding: 15px;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 10px;
    font-size: 0.9rem;
  }

  .modal-actions {
    padding-top: 15px;
    gap: 10px;
  }

  .btn-cancel,
  .btn-submit {
    padding: 12px 20px;
    font-size: 0.9rem;
  }

  /* Plan content */
  .plan-content {
    padding: 15px;
  }

  .plan-content h3 {
    font-size: 1.1rem;
  }

  .plan-stats {
    padding: 14px;
  }

  .plan-stat {
    padding: 8px 0;
    font-size: 0.88rem;
  }

  .plan-recommendation {
    padding: 14px;
  }

  /* Adjust modal mobile */
  .adjust-type-selector {
    flex-direction: row;
    gap: 8px;
  }

  .type-btn {
    padding: 10px 6px;
    font-size: 0.88rem;
    border-radius: 8px;
  }

  .current-stock-info {
    padding: 10px 14px;
    border-radius: 8px;
  }

  .info-label {
    font-size: 0.88rem;
  }

  .info-value {
    font-size: 1.1rem;
  }

  .adjust-preview {
    padding: 10px 14px;
    border-radius: 8px;
  }

  .preview-value {
    font-size: 1.1rem;
  }

  /* Alerts */
  .alerts-section {
    gap: 10px;
    margin-bottom: 15px;
  }

  .alert-box {
    padding: 14px;
    border-radius: 10px;
  }

  .alert-box h3 {
    font-size: 1rem;
  }

  .alert-box li {
    padding: 8px;
    font-size: 0.82rem;
  }

  /* Filters */
  .filters-bar {
    padding: 10px;
    border-radius: 10px;
    margin-bottom: 12px;
    gap: 8px;
  }

  .filter-select,
  .filter-search {
    padding: 10px;
    font-size: 0.88rem;
  }

  /* Empty state */
  .empty-state {
    padding: 30px 15px;
  }

  .empty-state p {
    font-size: 0.95rem;
  }

  /* Loading */
  .loading-spinner {
    font-size: 1.2rem;
  }
}

/* ═══════════════════════════════════════ */
/* Print Button                           */
/* ═══════════════════════════════════════ */
.btn-print {
  background: linear-gradient(135deg, #1565C0 0%, #0D47A1 100%);
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 10px rgba(21, 101, 192, 0.3);
}

.btn-print:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 15px rgba(21, 101, 192, 0.4);
}

/* ═══════════════════════════════════════ */
/* Inventory Sheet Button                 */
/* ═══════════════════════════════════════ */
.btn-inventory {
  background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 100%);
  color: white;
  border: none;
  padding: 12px 24px;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 10px rgba(46, 125, 50, 0.3);
}

.btn-inventory:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 15px rgba(46, 125, 50, 0.4);
}

/* ═══════════════════════════════════════ */
/* Summary Section                        */
/* ═══════════════════════════════════════ */
.stock-summary {
  background: white;
  border-radius: 15px;
  padding: 25px;
  margin-top: 25px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.stock-summary h3 {
  font-size: 1.3rem;
  color: #1B5E20;
  margin-bottom: 18px;
  padding-bottom: 10px;
  border-bottom: 2px solid #E8F5E9;
}

.summary-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 15px;
}

.summary-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px 15px;
  border-radius: 12px;
  transition: transform 0.2s ease;
}

.summary-card:hover {
  transform: translateY(-3px);
}

.summary-card.total {
  background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
  border: 1px solid #90CAF9;
}

.summary-card.critique {
  background: linear-gradient(135deg, #FFEBEE, #FFCDD2);
  border: 1px solid #EF9A9A;
}

.summary-card.expire {
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
  border: 1px solid #FFCC80;
}

.summary-card.ok {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  border: 1px solid #A5D6A7;
}

.summary-value {
  font-size: 2rem;
  font-weight: 800;
  color: #2d3748;
  line-height: 1;
}

.summary-label {
  font-size: 0.9rem;
  color: #555;
  margin-top: 8px;
  font-weight: 600;
  text-align: center;
}

/* ═══════════════════════════════════════ */
/* Ajuster Stock Modal                    */
/* ═══════════════════════════════════════ */
.btn-action.adjust {
  background: linear-gradient(135deg, #1565C0, #0D47A1);
}

.btn-action.adjust:hover {
  background: linear-gradient(135deg, #1976D2, #1565C0);
}

.current-stock-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #E3F2FD;
  border: 1px solid #90CAF9;
  border-radius: 10px;
  padding: 15px 20px;
  margin-bottom: 20px;
}

.info-label {
  font-size: 1rem;
  color: #555;
  font-weight: 500;
}

.info-value {
  font-size: 1.5rem;
  font-weight: 800;
  color: #1565C0;
}

.adjust-type-selector {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}

.type-btn {
  flex: 1;
  padding: 14px;
  border: 2px solid #ddd;
  border-radius: 10px;
  background: white;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  text-align: center;
}

.type-btn.add {
  color: #2E7D32;
}

.type-btn.add:hover,
.type-btn.add.active {
  background: #E8F5E9;
  border-color: #2E7D32;
  box-shadow: 0 4px 12px rgba(46, 125, 50, 0.2);
}

.type-btn.remove {
  color: #C62828;
}

.type-btn.remove:hover,
.type-btn.remove.active {
  background: #FFEBEE;
  border-color: #C62828;
  box-shadow: 0 4px 12px rgba(198, 40, 40, 0.2);
}

.adjust-preview {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 18px;
  border-radius: 10px;
  margin-bottom: 15px;
  background: #F5F5F5;
  border: 1px dashed #bbb;
}

.preview-label {
  font-weight: 500;
  color: #666;
}

.preview-value {
  font-size: 1.3rem;
  font-weight: 800;
}

.preview-value.positive {
  color: #2E7D32;
}

.preview-value.negative {
  color: #C62828;
}

.btn-add-stock {
  background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 100%) !important;
}

.btn-remove-stock {
  background: linear-gradient(135deg, #C62828 0%, #B71C1C 100%) !important;
}

.adjust-form .form-group {
  margin-bottom: 15px;
}

.adjust-form .form-group label {
  display: block;
  margin-bottom: 6px;
  font-weight: 600;
  color: #444;
}

.adjust-form .form-group input,
.adjust-form .form-group textarea {
  width: 100%;
  padding: 10px 14px;
  border: 2px solid #e0e0e0;
  border-radius: 8px;
  font-size: 1rem;
  transition: border-color 0.3s;
}

.adjust-form .form-group input:focus,
.adjust-form .form-group textarea:focus {
  border-color: #667eea;
  outline: none;
}

/* ═══════════════════════════════════════ */
/* Tab Navigation                         */
/* ═══════════════════════════════════════ */
.stock-tabs {
  display: flex;
  gap: 6px;
  margin-bottom: 20px;
  background: white;
  border-radius: 12px;
  padding: 6px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.tab-btn {
  flex: 1;
  padding: 14px 20px;
  border: none;
  border-radius: 10px;
  background: transparent;
  font-size: 1rem;
  font-weight: 600;
  color: #718096;
  cursor: pointer;
  transition: all 0.3s ease;
}

.tab-btn:hover {
  background: #f7fafc;
  color: #2d3748;
}

.tab-btn.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
}

/* ═══════════════════════════════════════ */
/* Charts Section                         */
/* ═══════════════════════════════════════ */
.charts-container {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.charts-toolbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 5px;
}

.charts-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.chart-card {
  background: white;
  border-radius: 15px;
  padding: 25px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.chart-card.full-width {
  width: 100%;
}

.chart-card h3 {
  margin: 0 0 20px 0;
  font-size: 1.15rem;
  color: #2d3748;
  padding-bottom: 12px;
  border-bottom: 2px solid #f0f0f0;
}

/* ═══════════════════════════════════════ */
/* Calendar Section                       */
/* ═══════════════════════════════════════ */
.calendar-container {
  background: white;
  border-radius: 15px;
  padding: 25px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.calendar-header-nav {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  margin-bottom: 20px;
}

.calendar-header-nav h3 {
  margin: 0;
  font-size: 1.4rem;
  color: #2d3748;
  min-width: 200px;
  text-align: center;
}

.cal-nav-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border: none;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  font-size: 1.1rem;
  cursor: pointer;
  transition: transform 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-nav-btn:hover {
  transform: scale(1.1);
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4px;
  margin-bottom: 25px;
}

.calendar-day-header {
  text-align: center;
  font-weight: 700;
  color: #667eea;
  padding: 8px 0;
  font-size: 0.85rem;
  text-transform: uppercase;
}

.calendar-day {
  min-height: 90px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 6px;
  position: relative;
  transition: all 0.2s;
  background: #fafbfc;
}

.calendar-day.empty {
  background: transparent;
  border-color: transparent;
}

.calendar-day.today {
  border-color: #667eea;
  border-width: 2px;
  background: #f0f4ff;
}

.calendar-day.has-items {
  background: #fff;
}

.calendar-day.has-expired {
  background: #fff5f5;
  border-color: #f5576c;
}

.calendar-day.has-warning {
  background: #fffbeb;
  border-color: #f5a623;
}

.day-number {
  font-weight: 700;
  font-size: 0.85rem;
  color: #2d3748;
  display: block;
  margin-bottom: 4px;
}

.calendar-day.today .day-number {
  color: #667eea;
}

.day-items {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.day-item {
  font-size: 0.68rem;
  padding: 2px 4px;
  border-radius: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  background: #e0e7ff;
  color: #3730a3;
  font-weight: 500;
}

.day-item.critique {
  background: #fee2e2;
  color: #991b1b;
}

.day-item.expire {
  background: #1f2937;
  color: white;
}

.day-item.faible {
  background: #fef3c7;
  color: #92400e;
}

.day-item.more {
  background: #f3f4f6;
  color: #6b7280;
  text-align: center;
  font-style: italic;
}

/* Expiration List */
.expiration-list {
  margin-top: 25px;
  border-top: 2px solid #f0f0f0;
  padding-top: 20px;
}

.expiration-list h3 {
  margin: 0 0 15px 0;
  font-size: 1.2rem;
  color: #2d3748;
}

.exp-items {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.exp-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  border-radius: 10px;
  background: #f7fafc;
  border-left: 4px solid #e2e8f0;
  transition: transform 0.2s;
}

.exp-item:hover {
  transform: translateX(4px);
}

.exp-item.urgent {
  background: #fff5f5;
  border-left-color: #f5576c;
}

.exp-item.warning {
  background: #fffbeb;
  border-left-color: #f5a623;
}

.exp-item.soon {
  background: #f0f4ff;
  border-left-color: #667eea;
}

.exp-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.exp-info strong {
  color: #2d3748;
  font-size: 0.95rem;
}

.exp-qty {
  font-size: 0.82rem;
  color: #718096;
}

.exp-date {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
}

.exp-days {
  font-weight: 800;
  font-size: 1.1rem;
  color: #2d3748;
}

.exp-item.urgent .exp-days {
  color: #f5576c;
}

.exp-item.warning .exp-days {
  color: #f5a623;
}

.exp-full-date {
  font-size: 0.78rem;
  color: #a0aec0;
}

/* ═══════════════════════════════════════ */
/* History Modal                          */
/* ═══════════════════════════════════════ */
.history-content {
  padding: 25px;
  max-height: 60vh;
  overflow-y: auto;
}

.history-timeline {
  position: relative;
  padding-left: 30px;
}

.history-item {
  position: relative;
  margin-bottom: 20px;
}

.history-dot {
  position: absolute;
  left: -30px;
  top: 6px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  border: 3px solid white;
  box-shadow: 0 0 0 2px #e2e8f0;
  z-index: 1;
}

.history-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: -24px;
  top: 20px;
  bottom: -20px;
  width: 2px;
  background: #e2e8f0;
}

.history-card {
  background: #f7fafc;
  border-radius: 10px;
  padding: 14px 16px;
  border: 1px solid #e2e8f0;
}

.history-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.history-action {
  font-weight: 700;
  font-size: 0.95rem;
}

.history-date {
  font-size: 0.8rem;
  color: #a0aec0;
}

.history-details {
  display: flex;
  gap: 20px;
  font-size: 0.88rem;
  color: #4a5568;
  margin-bottom: 6px;
}

.history-notes {
  font-size: 0.85rem;
  color: #718096;
  padding: 6px 10px;
  background: #edf2f7;
  border-radius: 6px;
  margin-top: 6px;
}

.history-user {
  font-size: 0.8rem;
  color: #a0aec0;
  margin-top: 4px;
}

.btn-action.history:hover {
  background: #e0e7ff;
}

/* ═══════════════════════════════════════ */
/* Responsive — Charts & Calendar        */
/* ═══════════════════════════════════════ */
@media (max-width: 768px) {
  .charts-row {
    grid-template-columns: 1fr;
  }

  .chart-card {
    padding: 15px;
  }

  .calendar-grid {
    gap: 2px;
  }

  .calendar-day {
    min-height: 60px;
    padding: 4px;
  }

  .day-number {
    font-size: 0.75rem;
  }

  .day-item {
    font-size: 0.6rem;
    padding: 1px 3px;
  }

  .calendar-header-nav h3 {
    font-size: 1.1rem;
    min-width: 140px;
  }

  .stock-tabs {
    flex-direction: row;
    overflow-x: auto;
  }

  .tab-btn {
    padding: 10px 14px;
    font-size: 0.88rem;
    white-space: nowrap;
  }
}

@media (max-width: 576px) {
  .charts-row {
    grid-template-columns: 1fr;
  }

  .chart-card {
    padding: 12px;
    border-radius: 10px;
  }

  .chart-card h3 {
    font-size: 1rem;
    margin-bottom: 12px;
  }

  .calendar-container {
    padding: 12px;
    border-radius: 12px;
  }

  .calendar-day {
    min-height: 45px;
    padding: 3px;
    border-radius: 4px;
  }

  .day-number {
    font-size: 0.7rem;
  }

  .day-items {
    display: none;
  }

  .calendar-day.has-items::after {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #667eea;
    margin: 2px auto 0;
  }

  .calendar-day.has-expired::after {
    background: #f5576c;
  }

  .calendar-day.has-warning::after {
    background: #f5a623;
  }

  .exp-item {
    padding: 10px 12px;
  }

  .exp-info strong {
    font-size: 0.88rem;
  }

  .exp-days {
    font-size: 0.95rem;
  }

  .history-content {
    padding: 15px;
  }

  .history-details {
    flex-direction: column;
    gap: 4px;
  }

  .history-top {
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .stock-tabs {
    gap: 4px;
    padding: 4px;
  }

  .tab-btn {
    padding: 10px 8px;
    font-size: 0.8rem;
  }
}

/* ═══════════════════════════════════════════════════════════ */
/* GLOBAL HISTORY TAB - الخروج والاستهلاك                     */
/* ═══════════════════════════════════════════════════════════ */

.global-history-container {
  padding: 20px 0;
}

/* Stats Cards */
.history-stats-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.history-stat-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 20px;
  border-radius: 16px;
  background: linear-gradient(135deg, #fff, #f8fafc);
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  transition: transform 0.2s, box-shadow 0.2s;
}

.history-stat-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(0,0,0,0.1);
}

.history-stat-card.sortie {
  border-left: 4px solid #f5576c;
}

.history-stat-card.consommation {
  border-left: 4px solid #667eea;
}

.history-stat-card.total-movement {
  border-left: 4px solid #764ba2;
}

.hstat-icon {
  font-size: 2.2rem;
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  background: linear-gradient(135deg, #f0f4ff, #e8ecff);
}

.history-stat-card.sortie .hstat-icon {
  background: linear-gradient(135deg, #fff0f0, #ffe0e0);
}

.history-stat-card.consommation .hstat-icon {
  background: linear-gradient(135deg, #f0f4ff, #e0e8ff);
}

.hstat-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.hstat-value {
  font-size: 1.8rem;
  font-weight: 800;
  color: #1a202c;
  line-height: 1;
}

.hstat-label {
  font-size: 0.85rem;
  color: #718096;
  font-weight: 500;
}

.hstat-qty {
  font-size: 0.8rem;
  color: #a0aec0;
  font-weight: 600;
}

/* Sortie Breakdown */
.sortie-breakdown {
  margin-bottom: 24px;
  padding: 20px;
  background: #fff;
  border-radius: 14px;
  border: 1px solid #e2e8f0;
  box-shadow: 0 1px 4px rgba(0,0,0,0.04);
}

.sortie-breakdown h3 {
  margin: 0 0 14px 0;
  font-size: 1.05rem;
  color: #2d3748;
}

.breakdown-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.breakdown-chip {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  border-radius: 12px;
  background: #f8fafc;
  border: 2px solid #e2e8f0;
  font-size: 0.9rem;
  transition: transform 0.15s;
}

.breakdown-chip:hover {
  transform: scale(1.03);
}

.chip-icon {
  font-size: 1.2rem;
}

.chip-label {
  color: #4a5568;
  font-weight: 500;
}

.chip-count {
  color: #fff;
  font-weight: 700;
  font-size: 0.8rem;
  padding: 2px 8px;
  border-radius: 8px;
  min-width: 24px;
  text-align: center;
}

.chip-qty {
  font-size: 0.78rem;
  color: #a0aec0;
}

/* History Filters */
.history-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: flex-end;
  padding: 18px;
  background: linear-gradient(135deg, #f8fafc, #edf2f7);
  border-radius: 14px;
  margin-bottom: 20px;
  border: 1px solid #e2e8f0;
}

.hfilter-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 160px;
}

.hfilter-group label {
  font-size: 0.78rem;
  font-weight: 600;
  color: #4a5568;
}

.hfilter-group select,
.hfilter-group input {
  padding: 8px 12px;
  border-radius: 10px;
  border: 1px solid #cbd5e0;
  font-size: 0.88rem;
  background: #fff;
  transition: border-color 0.2s;
}

.hfilter-group select:focus,
.hfilter-group input:focus {
  border-color: #667eea;
  outline: none;
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
}

.hfilter-search-btn {
  padding: 8px 16px;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-size: 0.88rem;
  font-weight: 600;
  transition: transform 0.15s, box-shadow 0.15s;
}

.hfilter-search-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 2px 8px rgba(102, 126, 234, 0.3);
}

.hfilter-reset-btn {
  padding: 8px 14px;
  background: #f1f5f9;
  color: #475569;
  border: 1px solid #cbd5e0;
  border-radius: 10px;
  cursor: pointer;
  font-size: 0.88rem;
  font-weight: 500;
  transition: background 0.2s;
}

.hfilter-reset-btn:hover {
  background: #e2e8f0;
}

/* History Table */
.history-table-wrapper {
  overflow-x: auto;
  border-radius: 14px;
  border: 1px solid #e2e8f0;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.history-table thead th {
  background: linear-gradient(135deg, #2d3748, #1a202c);
  color: #fff;
  padding: 14px 12px;
  font-size: 0.85rem;
  font-weight: 600;
  text-align: right;
  white-space: nowrap;
  border: none;
}

.history-table tbody tr {
  transition: background 0.15s;
}

.history-table tbody tr:hover {
  background: #f0f4ff !important;
}

.history-row.sortie {
  border-left: 3px solid #f5576c;
}

.history-row.consommation {
  border-left: 3px solid #667eea;
}

.history-row.ajout {
  border-left: 3px solid #43e97b;
}

.history-row.reapprovisionnement {
  border-left: 3px solid #764ba2;
}

.history-row.modification {
  border-left: 3px solid #f5a623;
}

.history-date-cell {
  white-space: nowrap;
}

.date-main {
  font-weight: 600;
  font-size: 0.9rem;
  color: #2d3748;
}

.date-time {
  font-size: 0.75rem;
  color: #a0aec0;
}

.product-name {
  font-weight: 600;
  color: #2d3748;
}

.product-cat {
  font-size: 0.78rem;
  color: #a0aec0;
}

.action-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 10px;
  border-radius: 8px;
  color: #fff;
  font-size: 0.82rem;
  font-weight: 600;
  white-space: nowrap;
}

.qty-cell {
  white-space: nowrap;
}

.qty-value {
  font-weight: 700;
  font-size: 0.95rem;
}

.remaining-cell {
  font-weight: 500;
  color: #4a5568;
  white-space: nowrap;
}

.details-cell {
  max-width: 250px;
}

.detail-tag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 8px;
  border-radius: 6px;
  background: #fef3f2;
  color: #dc2626;
  font-size: 0.78rem;
  font-weight: 600;
  margin-bottom: 4px;
}

.detail-dest {
  font-size: 0.82rem;
  color: #667eea;
  font-weight: 500;
  margin-bottom: 2px;
}

.detail-notes {
  font-size: 0.78rem;
  color: #718096;
  font-style: italic;
}

.user-cell {
  white-space: nowrap;
  font-size: 0.85rem;
  color: #4a5568;
}

.no-user {
  color: #cbd5e0;
}

/* History Pagination */
.history-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-top: 20px;
  padding: 12px;
}

.history-pagination button {
  padding: 8px 18px;
  border-radius: 10px;
  border: 1px solid #cbd5e0;
  background: #fff;
  cursor: pointer;
  font-size: 0.88rem;
  font-weight: 600;
  color: #4a5568;
  transition: all 0.15s;
}

.history-pagination button:hover:not(:disabled) {
  background: #667eea;
  color: #fff;
  border-color: #667eea;
}

.history-pagination button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.page-info {
  font-size: 0.88rem;
  color: #718096;
  font-weight: 500;
}

/* ═══════════════════════════════════════════════════════════ */
/* SORTIE MODAL - خروج                                       */
/* ═══════════════════════════════════════════════════════════ */

.sortie-modal {
  max-width: 580px;
}

.sortie-header {
  background: linear-gradient(135deg, #f5576c, #e74c3c) !important;
}

.sortie-header h2 {
  color: #fff !important;
}

.sortie-header .modal-close {
  color: #fff !important;
}

.sortie-form {
  padding: 24px;
}

.sortie-type-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-bottom: 20px;
}

.sortie-type-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 14px 8px;
  border-radius: 14px;
  border: 2px solid #e2e8f0;
  background: #f8fafc;
  cursor: pointer;
  transition: all 0.2s;
}

.sortie-type-btn:hover {
  border-color: #f5576c;
  background: #fff0f0;
}

.sortie-type-btn.active {
  border-color: #f5576c;
  background: linear-gradient(135deg, #fff5f5, #ffe0e0);
  box-shadow: 0 2px 8px rgba(245, 87, 108, 0.2);
}

.st-icon {
  font-size: 1.6rem;
}

.st-label {
  font-size: 0.82rem;
  font-weight: 700;
  color: #2d3748;
}

.st-label-fr {
  font-size: 0.7rem;
  color: #a0aec0;
}

.sortie-preview {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 16px;
  border-radius: 10px;
  background: #fef3f2;
  margin-bottom: 16px;
}

.sortie-preview .preview-label {
  font-size: 0.85rem;
  color: #718096;
  font-weight: 500;
}

.sortie-preview .preview-value {
  font-weight: 700;
  font-size: 1.1rem;
}

.sortie-preview .preview-value.negative {
  color: #e53e3e;
}

.btn-sortie-submit {
  background: linear-gradient(135deg, #f5576c, #e74c3c) !important;
}

.btn-sortie-submit:hover {
  box-shadow: 0 4px 12px rgba(245, 87, 108, 0.3) !important;
}

/* Sortie button styling */
.btn-action.sortie:hover {
  background: #fef3f2;
  transform: scale(1.15);
}

/* History modal extra styles */
.history-sortie-type {
  padding: 4px 10px;
  border-radius: 8px;
  background: #fef3f2;
  color: #e53e3e;
  font-size: 0.82rem;
  font-weight: 600;
  margin-top: 4px;
  display: inline-block;
}

.history-destination {
  font-size: 0.82rem;
  color: #667eea;
  font-weight: 500;
  margin-top: 4px;
}

/* Responsive */
@media (max-width: 768px) {
  .history-stats-cards {
    grid-template-columns: 1fr;
  }

  .sortie-type-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .history-filters {
    flex-direction: column;
    gap: 10px;
  }

  .hfilter-group {
    min-width: 100%;
  }

  .history-table th,
  .history-table td {
    padding: 8px 6px;
    font-size: 0.78rem;
  }

  .breakdown-chips {
    flex-direction: column;
  }

  .history-pagination {
    flex-direction: column;
    gap: 8px;
  }
}

/* ═══════════════════════════════════════════════════════════════════ */
/* BATCH TOOLBAR                                                      */
/* ═══════════════════════════════════════════════════════════════════ */
.batch-toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
  border: 1px solid #c7d2fe;
  border-radius: 10px;
  margin-bottom: 12px;
}
.batch-toolbar .batch-count {
  font-weight: 600;
  color: #4338ca;
  font-size: 0.9rem;
}
.batch-toolbar .btn-batch { padding: 6px 14px; border-radius: 6px; border: none; font-size: 0.82rem; cursor: pointer; font-weight: 600; }
.btn-batch-consume { background: #10b981; color: #fff; }
.btn-batch-sortie { background: #f59e0b; color: #fff; }
.btn-batch-delete { background: #ef4444; color: #fff; }
.btn-batch:hover { opacity: 0.85; transform: translateY(-1px); }
.select-checkbox { width: 18px; height: 18px; cursor: pointer; accent-color: #667eea; }

/* ═══════════════════════════════════════════════════════════════════ */
/* VALUE DASHBOARD TAB                                                */
/* ═══════════════════════════════════════════════════════════════════ */
.value-dashboard { padding: 4px 0; }
.dashboard-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px; }
.dash-card { display: flex; align-items: center; gap: 14px; padding: 20px; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
.dash-card.primary { background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; }
.dash-card.success { background: linear-gradient(135deg, #10b981, #059669); color: #fff; }
.dash-card.danger { background: linear-gradient(135deg, #ef4444, #dc2626); color: #fff; }
.dash-card.info { background: linear-gradient(135deg, #3b82f6, #2563eb); color: #fff; }
.dash-icon { font-size: 2rem; }
.dash-info { display: flex; flex-direction: column; }
.dash-value { font-size: 1.4rem; font-weight: 700; }
.dash-label { font-size: 0.78rem; opacity: 0.9; }

.dashboard-section { background: #fff; border-radius: 12px; padding: 20px; margin-bottom: 20px; box-shadow: 0 1px 8px rgba(0,0,0,0.05); }
.dashboard-section h3 { margin-bottom: 14px; color: #1e293b; font-size: 1.05rem; }

.stock-comparison { margin-top: 10px; }
.comp-bar { width: 100%; height: 24px; background: #e5e7eb; border-radius: 12px; overflow: hidden; }
.comp-fill { height: 100%; background: linear-gradient(90deg, #667eea, #764ba2); border-radius: 12px; transition: width 0.5s ease; }
.comp-labels { display: flex; justify-content: space-between; margin-top: 8px; font-size: 0.82rem; color: #64748b; }

.value-by-cat { display: flex; flex-direction: column; gap: 8px; }
.cat-value-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: #f8fafc; border-radius: 8px; border-left: 4px solid #667eea; }
.cat-name { font-weight: 600; color: #1e293b; }
.cat-count { color: #64748b; font-size: 0.82rem; }
.cat-valeur { font-weight: 700; color: #667eea; }

/* ═══════════════════════════════════════════════════════════════════ */
/* REORDER TAB                                                        */
/* ═══════════════════════════════════════════════════════════════════ */
.reorder-container { padding: 4px 0; }
.reorder-summary { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; margin-bottom: 20px; }
.reorder-stat { text-align: center; padding: 16px; border-radius: 12px; background: #fff; box-shadow: 0 1px 8px rgba(0,0,0,0.05); }
.reorder-stat.urgent { border-top: 4px solid #ef4444; }
.reorder-stat.high { border-top: 4px solid #f59e0b; }
.reorder-stat.medium { border-top: 4px solid #eab308; }
.reorder-stat.cost { border-top: 4px solid #667eea; }
.rs-value { display: block; font-size: 1.6rem; font-weight: 700; color: #1e293b; }
.rs-label { font-size: 0.82rem; color: #64748b; }

.reorder-table-wrapper { overflow-x: auto; }
.reorder-table .urgency-badge { padding: 4px 10px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; }
.urgency-badge.urgent { background: #fef2f2; color: #dc2626; }
.urgency-badge.high { background: #fffbeb; color: #d97706; }
.urgency-badge.medium { background: #fefce8; color: #ca8a04; }
.qty-low { color: #ef4444; font-weight: 600; }
.qty-recommend { color: #10b981; }
.cost-cell { color: #667eea; font-weight: 600; }
tr.urgency-urgent { background: #fef2f2; }
tr.urgency-high { background: #fffbeb; }
tr.urgency-medium { background: #fefce8; }
.sub-text { font-size: 0.75rem; color: #94a3b8; }

/* ═══════════════════════════════════════════════════════════════════ */
/* SUPPLIERS TAB                                                      */
/* ═══════════════════════════════════════════════════════════════════ */
.suppliers-container { padding: 4px 0; }
.suppliers-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
.supplier-card { background: #fff; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); overflow: hidden; }
.supplier-header { display: flex; justify-content: space-between; align-items: center; padding: 16px 18px; background: linear-gradient(135deg, #f0f9ff, #e0f2fe); border-bottom: 1px solid #bae6fd; }
.supplier-header h3 { margin: 0; font-size: 1rem; color: #0369a1; }
.supplier-value { font-weight: 700; color: #0369a1; font-size: 1.1rem; }
.supplier-stats { display: flex; gap: 16px; padding: 10px 18px; font-size: 0.82rem; color: #64748b; background: #f8fafc; }
.supplier-items { padding: 12px 18px; display: flex; flex-direction: column; gap: 6px; }
.supplier-item { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #f1f5f9; font-size: 0.85rem; }
.supplier-more { text-align: center; color: #667eea; font-size: 0.82rem; padding: 6px 0; }

/* ═══════════════════════════════════════════════════════════════════ */
/* MEALS TAB                                                          */
/* ═══════════════════════════════════════════════════════════════════ */
.meals-container { padding: 4px 0; }
.meals-alert { background: linear-gradient(135deg, #fffbeb, #fef3c7); border: 1px solid #fbbf24; border-radius: 12px; padding: 16px; margin-bottom: 20px; }
.meals-alert h3 { color: #92400e; margin-bottom: 10px; font-size: 0.95rem; }
.expiring-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.expiring-chip { background: #fff; border: 1px solid #fbbf24; padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; color: #92400e; }

.meal-suggestions-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-bottom: 24px; }
.meal-card { background: #fff; border-radius: 14px; padding: 18px; box-shadow: 0 2px 12px rgba(0,0,0,0.05); border-top: 4px solid #10b981; }
.meal-card.priority-high { border-top-color: #ef4444; }
.meal-card.priority-medium { border-top-color: #f59e0b; }
.meal-card.priority-low { border-top-color: #10b981; }
.meal-card h3 { color: #1e293b; margin-bottom: 6px; font-size: 1.05rem; }
.meal-desc { color: #64748b; font-size: 0.82rem; margin-bottom: 12px; }
.meal-ingredients h4 { font-size: 0.85rem; color: #475569; margin-bottom: 6px; }
.meal-ingredient { display: flex; justify-content: space-between; padding: 4px 0; font-size: 0.82rem; border-bottom: 1px dashed #e2e8f0; }
.meal-servings { margin-top: 10px; font-weight: 600; color: #667eea; text-align: center; padding: 6px; background: #eef2ff; border-radius: 8px; }

.available-by-cat { background: #fff; border-radius: 12px; padding: 20px; box-shadow: 0 1px 8px rgba(0,0,0,0.05); }
.available-by-cat h3 { margin-bottom: 14px; color: #1e293b; }
.cat-available-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
.cat-available-card { background: #f8fafc; border-radius: 10px; padding: 14px; border: 1px solid #e2e8f0; }
.cat-available-card h4 { margin-bottom: 6px; color: #334155; }
.cat-count-badge { display: inline-block; background: #667eea; color: #fff; padding: 2px 10px; border-radius: 20px; font-size: 0.75rem; margin-bottom: 8px; }
.cat-items-list { display: flex; flex-wrap: wrap; gap: 6px; }
.cat-item-chip { background: #fff; border: 1px solid #cbd5e1; padding: 3px 10px; border-radius: 16px; font-size: 0.78rem; }

/* ═══════════════════════════════════════════════════════════════════ */
/* BATCH MODAL                                                        */
/* ═══════════════════════════════════════════════════════════════════ */
.batch-modal { max-width: 560px; }
.batch-count { font-weight: 600; color: #4338ca; margin-bottom: 10px; }
.batch-items-list { list-style: none; padding: 0; margin: 0 0 16px; max-height: 200px; overflow-y: auto; border: 1px solid #e5e7eb; border-radius: 8px; }
.batch-items-list li { padding: 8px 14px; border-bottom: 1px solid #f1f5f9; font-size: 0.85rem; }
.batch-items-list li:last-child { border-bottom: none; }
.batch-sortie-form .form-group { margin-bottom: 10px; }
.batch-warning { background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 12px; border-radius: 8px; font-weight: 600; text-align: center; }

/* ═══════════════════════════════════════════════════════════════════ */
/* INVENTORY MODAL                                                    */
/* ═══════════════════════════════════════════════════════════════════ */
.inventory-modal { max-width: 800px; width: 95vw; }
.inventory-info { color: #64748b; margin-bottom: 14px; font-size: 0.88rem; }
.inventory-table-wrapper { max-height: 50vh; overflow-y: auto; }
.inv-qty-input { width: 80px; padding: 6px 8px; border: 2px solid #e5e7eb; border-radius: 6px; font-size: 0.9rem; text-align: center; }
.inv-qty-input:focus { border-color: #667eea; outline: none; }
.inv-note-input { width: 120px; padding: 4px 8px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 0.82rem; }
.inv-diff tr { background: #fffbeb; }
.diff-pos { color: #10b981; font-weight: 700; }
.diff-neg { color: #ef4444; font-weight: 700; }
.diff-zero { color: #94a3b8; }

/* ═══════════════════════════════════════════════════════════════════ */
/* IMPORT MODAL                                                       */
/* ═══════════════════════════════════════════════════════════════════ */
.import-modal { max-width: 700px; width: 95vw; }
.import-actions { display: flex; gap: 12px; margin-bottom: 16px; justify-content: center; }
.btn-template, .btn-upload { padding: 10px 20px; border: 2px dashed #cbd5e1; background: #f8fafc; border-radius: 10px; cursor: pointer; font-weight: 600; color: #475569; transition: all 0.2s; }
.btn-template:hover, .btn-upload:hover { border-color: #667eea; color: #667eea; background: #eef2ff; }
.import-preview-count { font-weight: 600; color: #10b981; margin-bottom: 10px; }
.import-table-wrapper { max-height: 300px; overflow-y: auto; }
.more-rows { text-align: center; color: #64748b; font-style: italic; }

/* ═══════════════════════════════════════════════════════════════════ */
/* QR MODAL                                                           */
/* ═══════════════════════════════════════════════════════════════════ */
.qr-modal { max-width: 400px; text-align: center; }
.qr-body { display: flex; flex-direction: column; align-items: center; }
.qr-item-info { margin-bottom: 16px; }
.qr-item-info h3 { color: #1e293b; margin-bottom: 4px; }
.qr-item-info p { color: #64748b; font-size: 0.85rem; }
.qr-code-container { background: #fff; padding: 20px; border: 2px solid #e5e7eb; border-radius: 12px; display: inline-flex; flex-direction: column; align-items: center; gap: 8px; }
.qr-code-img { width: 200px; height: 200px; image-rendering: pixelated; }
.qr-label { font-weight: 700; font-size: 1.1rem; color: #1e293b; }
.qr-barcode { font-family: monospace; font-size: 0.85rem; color: #64748b; }

/* ═══════════════════════════════════════════════════════════════════ */
/* MODAL SHARED / FOOTER                                              */
/* ═══════════════════════════════════════════════════════════════════ */
.modal-footer { display: flex; justify-content: flex-end; gap: 10px; padding: 16px 20px; border-top: 1px solid #e5e7eb; }
.btn-cancel { padding: 8px 18px; border: 1px solid #d1d5db; background: #f9fafb; border-radius: 8px; cursor: pointer; font-weight: 500; color: #374151; }
.btn-cancel:hover { background: #e5e7eb; }
.btn-confirm { padding: 8px 18px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; color: #fff; }
.btn-confirm.btn-primary { background: linear-gradient(135deg, #667eea, #764ba2); }
.btn-confirm.btn-primary:hover { opacity: 0.9; }
.btn-confirm.btn-danger { background: linear-gradient(135deg, #ef4444, #dc2626); }
.btn-confirm.btn-danger:hover { opacity: 0.9; }
.btn-confirm:disabled { opacity: 0.5; cursor: not-allowed; }

/* ═══════════════════════════════════════════════════════════════════ */
/* EXPORT HISTORY BUTTON                                              */
/* ═══════════════════════════════════════════════════════════════════ */
.btn-export-history {
  padding: 8px 16px;
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  font-size: 0.85rem;
}
.btn-export-history:hover { opacity: 0.85; transform: translateY(-1px); }

/* TOOLBAR BUTTONS */
.toolbar-top-buttons { display: flex; gap: 8px; flex-wrap: wrap; }
.btn-inventory, .btn-import { padding: 8px 16px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 0.85rem; }
.btn-inventory { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: #fff; }
.btn-import { background: linear-gradient(135deg, #06b6d4, #0891b2); color: #fff; }
.btn-inventory:hover, .btn-import:hover { opacity: 0.85; transform: translateY(-1px); }

/* QR button in table */
.btn-qr { background: none; border: 1px solid #cbd5e1; padding: 4px 8px; border-radius: 6px; cursor: pointer; font-size: 0.9rem; }
.btn-qr:hover { background: #eef2ff; border-color: #667eea; }

/* ═══════════════════════════════════════════════════════════════════ */
/* RESPONSIVE ADDITIONS                                               */
/* ═══════════════════════════════════════════════════════════════════ */
@media (max-width: 768px) {
  .dashboard-cards { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .dash-card { padding: 14px; }
  .dash-value { font-size: 1.1rem; }

  .reorder-summary { grid-template-columns: repeat(2, 1fr); }
  .suppliers-grid { grid-template-columns: 1fr; }
  .meal-suggestions-grid { grid-template-columns: 1fr; }
  .cat-available-grid { grid-template-columns: 1fr; }

  .batch-toolbar { flex-wrap: wrap; }
  .inventory-modal, .import-modal { width: 98vw; }
  .import-actions { flex-direction: column; }

  .toolbar-top-buttons { width: 100%; }
}

