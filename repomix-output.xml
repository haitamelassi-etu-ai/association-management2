.stat-card-report.green {
  border-color: #dcfce7;
}

.stat-card-report.orange {
  border-color: #fed7aa;
}

.stat-card-report.purple {
  border-color: #e9d5ff;
}

.stat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}

.stat-icon-report {
  width: 50px;
  height: 50px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.75rem;
  background: linear-gradient(135deg, #f8fafc, #e2e8f0);
}

.stat-card-report.blue .stat-icon-report {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
}

.stat-card-report.green .stat-icon-report {
  background: linear-gradient(135deg, #dcfce7, #bbf7d0);
}

.stat-card-report.orange .stat-icon-report {
  background: linear-gradient(135deg, #fed7aa, #fdba74);
}

.stat-card-report.purple .stat-icon-report {
  background: linear-gradient(135deg, #e9d5ff, #d8b4fe);
}

.stat-trend {
  padding: 0.375rem 0.75rem;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 600;
}

.stat-trend.positive {
  background: #dcfce7;
  color: #16a34a;
}

.stat-trend.negative {
  background: #fee2e2;
  color: #dc2626;
}

.stat-label {
  font-size: 0.9rem;
  color: #64748b;
  margin-bottom: 0.5rem;
}

.stat-value-report {
  font-size: 2.5rem;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 0.5rem;
}

.stat-detail {
  font-size: 0.85rem;
  color: #64748b;
}

/* Breakdown Section */
.breakdown-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.5rem;
}

.breakdown-card {
  background: white;
  border-radius: 16px;
  padding: 2rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  display: flex;
  gap: 3rem;
  align-items: center;
}

.breakdown-chart {
  flex: 1;
  display: flex;
  justify-content: center;
}

.pie-chart {
  width: 250px;
  height: 250px;
  border-radius: 50%;
  background: conic-gradient(
    #10b981 0% 27%,
    #6366f1 27% 77%,
    #f59e0b 77% 92%,
    #8b5cf6 92% 100%
  );
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pie-center {
  width: 160px;
  height: 160px;
  border-radius: 50%;
  background: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pie-total {
  font-size: 3rem;
  font-weight: 700;
  color: #1e293b;
}

.pie-label {
  font-size: 0.9rem;
  color: #64748b;
  margin-top: 0.25rem;
}

.breakdown-legend {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  background: #f8fafc;
  border-radius: 10px;
  transition: all 0.3s;
}

.legend-item:hover {
  background: #f1f5f9;
  transform: translateX(5px);
}

.legend-color {
  width: 20px;
  height: 20px;
  border-radius: 6px;
}

.legend-color.heberge {
  background: #10b981;
}

.legend-color.sorti {
  background: #6366f1;
}

.legend-color.suivi {
  background: #f59e0b;
}

.legend-color.transfere {
  background: #8b5cf6;
}

.legend-label {
  flex: 1;
  color: #475569;
  font-weight: 500;
}

.legend-value {
  font-size: 1.25rem;
  font-weight: 700;
  color: #1e293b;
}

/* Bar Chart */
.chart-container {
  background: white;
  border-radius: 16px;
  padding: 2rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.bar-chart {
  display: flex;
  gap: 1rem;
  height: 300px;
  align-items: flex-end;
  padding: 1rem 0;
  margin-bottom: 1rem;
}

.bar-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

.bars {
  display: flex;
  gap: 0.25rem;
  height: 100%;
  align-items: flex-end;
}

.bar {
  width: 20px;
  border-radius: 6px 6px 0 0;
  position: relative;
  transition: all 0.3s;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 0.25rem;
}

.bar:hover {
  opacity: 0.8;
  transform: scaleY(1.05);
}

.bar.entrees {
  background: linear-gradient(180deg, #3b82f6, #2563eb);
}

.bar.sorties {
  background: linear-gradient(180deg, #10b981, #059669);
}

.bar-value {
  font-size: 0.75rem;
  font-weight: 600;
  color: white;
}

.bar-label {
  font-size: 0.85rem;
  color: #64748b;
  font-weight: 500;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 2rem;
  padding-top: 1rem;
  border-top: 2px solid #f1f5f9;
}

.chart-legend-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.9rem;
  color: #475569;
  font-weight: 500;
}

.chart-legend-color {
  width: 16px;
  height: 16px;
  border-radius: 4px;
}

.chart-legend-color.entrees {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
}

.chart-legend-color.sorties {
  background: linear-gradient(135deg, #10b981, #059669);
}

/* Activities Grid */
.activities-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
}

.activity-card {
  background: white;
  border-radius: 16px;
  padding: 1.5rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  gap: 1.25rem;
  transition: all 0.3s;
}

.activity-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
}

.activity-icon {
  width: 60px;
  height: 60px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.75rem;
}

.activity-icon.blue {
  background: linear-gradient(135deg, #dbeafe, #bfdbfe);
}

.activity-icon.green {
  background: linear-gradient(135deg, #dcfce7, #bbf7d0);
}

.activity-icon.orange {
  background: linear-gradient(135deg, #fed7aa, #fdba74);
}

.activity-icon.purple {
  background: linear-gradient(135deg, #e9d5ff, #d8b4fe);
}

.activity-content {
  flex: 1;
}

.activity-value {
  font-size: 2rem;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 0.25rem;
}

.activity-label {
  font-size: 0.9rem;
  color: #64748b;
}

/* Success Indicators */
.success-indicators {
  background: white;
  border-radius: 16px;
  padding: 2rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.indicator-item {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.indicator-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.indicator-label {
  font-weight: 600;
  color: #1e293b;
  font-size: 1rem;
}

.indicator-value {
  font-size: 1.5rem;
  font-weight: 700;
  color: #3b82f6;
}

.progress-bar {
  height: 12px;
  background: #f1f5f9;
  border-radius: 6px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #3b82f6, #2563eb);
  border-radius: 6px;
  transition: width 0.5s ease;
}

.indicator-footer {
  font-size: 0.85rem;
  color: #64748b;
}

/* Summary Table */
.summary-table {
  width: 100%;
  border-collapse: collapse;
}

.summary-table thead {
  background: linear-gradient(135deg, #f8fafc, #f1f5f9);
}

.summary-table th {
  padding: 1rem;
  text-align: left;
  font-weight: 600;
  color: #475569;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-bottom: 2px solid #e5e7eb;
}

.summary-table tbody tr {
  border-bottom: 1px solid #e5e7eb;
  transition: all 0.3s;
}

.summary-table tbody tr:hover {
  background: #f8fafc;
}

.summary-table td {
  padding: 1rem;
  color: #1e293b;
  font-size: 0.95rem;
}

.trend-up {
  color: #16a34a;
  font-weight: 600;
}

.trend-down {
  color: #dc2626;
  font-weight: 600;
}

.trend-stable {
  color: #64748b;
  font-weight: 600;
}

/* Responsive */
@media (max-width: 1024px) {
  .breakdown-card {
    flex-direction: column;
    gap: 2rem;
  }

  .bar-chart {
    gap: 0.5rem;
  }

  .bar {
    width: 15px;
  }
}

@media (max-width: 768px) {
  .page-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .export-buttons {
    width: 100%;
  }

  .btn-export {
    flex: 1;
    justify-content: center;
  }

  .period-selector {
    flex-direction: column;
  }

  .period-btn {
    text-align: center;
  }

  .stats-grid-reports {
    grid-template-columns: 1fr;
  }

  .pie-chart {
    width: 200px;
    height: 200px;
  }

  .pie-center {
    width: 130px;
    height: 130px;
  }

  .pie-total {
    font-size: 2rem;
  }

  .activities-grid {
    grid-template-columns: 1fr;
  }

  .bar-chart {
    gap: 0.25rem;
    height: 250px;
  }

  .bar {
    width: 12px;
  }

  .bar-value {
    font-size: 0.65rem;
  }

  .bar-label {
    font-size: 0.75rem;
  }
}

@media (max-width: 480px) {
  .chart-legend {
    flex-direction: column;
    gap: 0.5rem;
  }
}
