    grid-template-columns: 1fr;
  }
}

@media (max-width: 480px) {
  .announcement-card {
    padding: 1rem;
  }

  .announcement-body h3 {
    font-size: 1.1rem;
  }

  .announcement-body p {
    font-size: 0.9rem;
  }
}
