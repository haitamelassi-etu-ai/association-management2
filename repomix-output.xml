    const HIDE_AFTER = 140
    const DELTA = 6

    const update = () => {
      const y = window.scrollY
      setIsScrolled(y > 24)
      if (isMenuOpen || y <= HIDE_AFTER) {
        setIsHeaderHidden(false)
      } else if (y - lastY > DELTA) {
        setIsHeaderHidden(true)
      } else if (lastY - y > DELTA) {
        setIsHeaderHidden(false)
