  transition: all 0.2s;
}

.type-btn:hover {
  border-color: var(--primary-color, #3498db);
}

.type-btn.active {
  background: var(--primary-color, #3498db);
  border-color: var(--primary-color, #3498db);
  color: #fff;
}

.priority-btn {
  padding: 8px 16px;
  border: 2px solid var(--priority-color);
  background: #fff;
  border-radius: 8px;
  cursor: pointer;
  font-size: 13px;
  transition: all 0.2s;
}

.priority-btn.active {
  background: var(--priority-color);
  color: #fff;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

/* Detail Modal */
.detail-item {
  margin-bottom: 16px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border-color, #e8e8e8);
}

.detail-item strong {
  display: block;
  font-size: 12px;
  color: var(--text-secondary, #888);
  margin-bottom: 4px;
  text-transform: uppercase;
}

.detail-item p {
  margin: 8px 0 0;
  white-space: pre-wrap;
}

.action-section {
  margin-top: 20px;
  padding-top: 20px;
  border-top: 2px dashed var(--border-color, #e0e0e0);
}

.action-buttons {
  display: flex;
  gap: 12px;
}

.approve-btn,
.reject-btn {
  flex: 1;
  padding: 12px;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-size: 15px;
  font-weight: 600;
  transition: all 0.2s;
}

.approve-btn {
  background: #27ae60;
  color: #fff;
}

.approve-btn:hover {
  background: #219a52;
}

.reject-btn {
  background: #e74c3c;
  color: #fff;
}

.reject-btn:hover {
  background: #c0392b;
}

.history-section {
  margin-top: 20px;
}

.history-section h4 {
  margin: 0 0 12px;
  font-size: 16px;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.history-item {
  padding: 12px;
  background: var(--input-bg, #f8f9fa);
  border-radius: 8px;
  font-size: 13px;
}

.history-action {
  text-transform: capitalize;
  font-weight: 500;
}

.history-date {
  color: var(--text-secondary, #888);
  margin-left: 8px;
}

.history-comment {
  margin: 8px 0 0;
  font-style: italic;
  color: var(--text-secondary, #666);
}

/* Loading & Empty */
.loading-state,
.empty-state {
  padding: 60px 20px;
  text-align: center;
  color: var(--text-secondary, #666);
}

.spinner {
  width: 40px;
  height: 40px;
  border: 3px solid var(--border-color, #e0e0e0);
  border-top-color: var(--primary-color, #3498db);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 16px;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-icon {
  font-size: 48px;
  display: block;
  margin-bottom: 16px;
  opacity: 0.5;
}

/* Dark mode */
[data-theme="dark"] .approval-workflow,
[data-theme="dark"] .request-modal,
[data-theme="dark"] .detail-modal {
  background: var(--card-bg, #1e1e1e);
}

[data-theme="dark"] .request-card,
[data-theme="dark"] .workflow-tabs {
  background: var(--input-bg, #2d2d2d);
}

[data-theme="dark"] .type-btn,
[data-theme="dark"] .priority-btn {
  background: var(--card-bg, #1e1e1e);
  color: var(--text-color, #e0e0e0);
}

/* Responsive */
@media (max-width: 768px) {
  .workflow-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .new-request-btn {
    width: 100%;
    justify-content: center;
  }

  .request-card {
    flex-direction: column;
    align-items: flex-start;
  }

  .request-icon {
    display: none;
  }

  .request-actions {
    width: 100%;
    justify-content: flex-end;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .action-buttons {
    flex-direction: column;
  }
}
</file>

<file path="src/components/AuditLogViewer.css">
.audit-log-viewer {
  background: var(--card-bg, #fff);
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
}

.audit-header {
  margin-bottom: 24px;
}

.audit-header h2 {
  margin: 0;
  font-size: 24px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.audit-header p {
  margin: 8px 0 0;
  color: var(--text-secondary, #666);
  font-size: 14px;
}

/* Stats */
.audit-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.stat-card {
  background: var(--input-bg, #f8f9fa);
  border-radius: 12px;
  padding: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.stat-icon {
  font-size: 28px;
}

.stat-info {
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 24px;
  font-weight: 700;
  color: var(--primary-color, #3498db);
}

.stat-label {
  font-size: 12px;
  color: var(--text-secondary, #666);
}

/* Filters */
.audit-filters {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 20px;
  padding: 16px;
  background: var(--input-bg, #f8f9fa);
  border-radius: 12px;
}

.audit-filters select,
.audit-filters input {
  padding: 10px 14px;
  border: 2px solid var(--border-color, #e0e0e0);
  border-radius: 8px;
  font-size: 14px;
  background: #fff;
  min-width: 160px;
}

.audit-filters select:focus,
.audit-filters input:focus {
  outline: none;
  border-color: var(--primary-color, #3498db);
}

.clear-filters {
  padding: 10px 16px;
  border: none;
  background: #e74c3c;
  color: #fff;
  border-radius: 8px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.2s;
}

.clear-filters:hover {
  background: #c0392b;
}

/* Table */
.audit-table-container {
  overflow-x: auto;
  border: 1px solid var(--border-color, #e0e0e0);
  border-radius: 12px;
}

.audit-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
}

.audit-table th {
  background: var(--input-bg, #f8f9fa);
  padding: 14px 16px;
  text-align: left;
  font-weight: 600;
  color: var(--text-secondary, #666);
  border-bottom: 2px solid var(--border-color, #e0e0e0);
  white-space: nowrap;
}

.audit-table td {
  padding: 12px 16px;
  border-bottom: 1px solid var(--border-color, #e8e8e8);
  vertical-align: middle;
}

.audit-table tr:hover {
  background: var(--input-bg, #f8f9fa);
}

.date-cell {
  white-space: nowrap;
  font-family: monospace;
  font-size: 13px;
}

.user-cell {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.user-name {
  font-weight: 500;
}

.user-role {
  font-size: 11px;
  color: var(--text-secondary, #888);
  text-transform: uppercase;
}

.unknown-user {
  color: var(--text-secondary, #999);
  font-style: italic;
}

.action-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 6px;
  color: #fff;
  font-size: 12px;
  font-weight: 500;
  text-transform: capitalize;
}

.resource-cell {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.resource-id {
  font-size: 11px;
  color: var(--text-secondary, #888);
  font-family: monospace;
}

.details-cell details {
  cursor: pointer;
}

.details-cell summary {
  color: var(--primary-color, #3498db);
  font-size: 13px;
}

.details-cell pre {
  margin-top: 8px;
  padding: 12px;
  background: var(--input-bg, #f5f5f5);
  border-radius: 8px;
  font-size: 11px;
  overflow-x: auto;
  max-width: 300px;
}

.ip-cell {
  font-family: monospace;
  font-size: 12px;
  color: var(--text-secondary, #666);
}

/* Loading & Empty */
.loading-state,
.empty-state {
  padding: 60px 20px;
  text-align: center;
  color: var(--text-secondary, #666);
}

.spinner {
  width: 40px;
  height: 40px;
  border: 3px solid var(--border-color, #e0e0e0);
  border-top-color: var(--primary-color, #3498db);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 16px;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-icon {
  font-size: 48px;
  display: block;
  margin-bottom: 16px;
  opacity: 0.5;
}

/* Pagination */
.audit-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid var(--border-color, #e0e0e0);
}

.audit-pagination button {
  padding: 8px 16px;
  border: 2px solid var(--border-color, #e0e0e0);
  background: #fff;
  border-radius: 8px;
  cursor: pointer;
  font-size: 14px;
  transition: all 0.2s;
}

.audit-pagination button:hover:not(:disabled) {
  border-color: var(--primary-color, #3498db);
  color: var(--primary-color, #3498db);
}

.audit-pagination button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.audit-pagination span {
  font-size: 14px;
  color: var(--text-secondary, #666);
}

/* Dark mode */
[data-theme="dark"] .audit-log-viewer {
  background: var(--card-bg, #1e1e1e);
}

[data-theme="dark"] .stat-card,
[data-theme="dark"] .audit-filters {
  background: var(--input-bg, #2d2d2d);
}

[data-theme="dark"] .audit-filters select,
[data-theme="dark"] .audit-filters input,
[data-theme="dark"] .audit-pagination button {
  background: var(--card-bg, #1e1e1e);
  border-color: var(--border-color, #404040);
  color: var(--text-color, #e0e0e0);
}

[data-theme="dark"] .audit-table th {
  background: var(--input-bg, #2d2d2d);
}

[data-theme="dark"] .audit-table tr:hover {
  background: var(--input-bg, #2d2d2d);
}

/* Responsive */
@media (max-width: 768px) {
  .audit-filters {
    flex-direction: column;
  }

  .audit-filters select,
  .audit-filters input {
    width: 100%;
  }

  .audit-table {
    font-size: 12px;
  }

  .audit-table th,
  .audit-table td {
    padding: 10px 8px;
  }
}
</file>

