} from 'lucide-react';
import { canAccessPath, getRoleLabel } from '../utils/permissions';

const normalize = (value) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');

export const ProfessionalSidebar = ({ user, onLogout }) => {
