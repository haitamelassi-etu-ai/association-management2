<file path="src/components/VolunteerPortal.css">
.volunteer-portal { padding: 20px; max-width: 1400px; margin: 0 auto; }
.volunteer-portal .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px; }
.volunteer-portal .page-header h1 { font-size: 1.6rem; color: #1a1a2e; margin: 0; }
