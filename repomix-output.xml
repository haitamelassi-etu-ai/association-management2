  background: var(--input-bg, #2d2d2d);
}

[data-theme="dark"] .ticket-number {
  background: var(--input-bg, #2d2d2d);
}

/* Responsive */
@media (max-width: 768px) {
  .ticket-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .new-ticket-btn {
    width: 100%;
  }

  .category-selector {
    grid-template-columns: repeat(2, 1fr);
  }

  .ticket-card {
    flex-direction: column;
  }

  .ticket-icon {
    display: none;
  }
}
