/* ══════════════════════════════════════════════
   BarcodeScanner — Modal & Camera Styles
   ══════════════════════════════════════════════ */

.barcode-scanner-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  backdrop-filter: blur(4px);
}

.barcode-scanner-modal {
  background: #fff;
  border-radius: 16px;
  width: 95%;
  max-width: 480px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  animation: scannerSlideIn 0.3s ease;
}

@keyframes scannerSlideIn {
  from {
    opacity: 0;
    transform: translateY(30px) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ── Header ── */
.scanner-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid #e5e7eb;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16px 16px 0 0;
}

.scanner-header h2 {
  margin: 0;
  font-size: 1.15rem;
  color: #fff;
  font-weight: 600;
}

.scanner-close {
  background: rgba(255, 255, 255, 0.2);
  border: none;
  color: #fff;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  font-size: 1.1rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}

.scanner-close:hover {
  background: rgba(255, 255, 255, 0.35);
}

/* ── Body ── */
.scanner-body {
  padding: 20px;
}

/* Loading */
.scanner-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px;
  gap: 16px;
  color: #6b7280;
}

.scanner-spinner {
  width: 40px;
  height: 40px;
  border: 4px solid #e5e7eb;
  border-top-color: #667eea;
  border-radius: 50%;
  animation: scannerSpin 0.8s linear infinite;
}

@keyframes scannerSpin {
  to { transform: rotate(360deg); }
}

.scanner-loading p {
  margin: 0;
  font-size: 0.95rem;
}

/* Error */
.scanner-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30px 20px;
  gap: 12px;
  text-align: center;
}

.scanner-error .error-icon {
  font-size: 2rem;
}

.scanner-error p {
  margin: 0;
  font-size: 0.9rem;
  color: #dc2626;
  line-height: 1.5;
}

.btn-retry {
  padding: 8px 20px;
  background: #667eea;
  color: #fff;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-size: 0.9rem;
  transition: background 0.2s;
}

.btn-retry:hover {
  background: #5a6fd6;
}

/* Video */
.scanner-video-container {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  background: #000;
  margin-bottom: 16px;
}

.scanner-video-container.hidden {
  display: none;
}

.scanner-video {
  width: 100%;
  height: auto;
  display: block;
  min-height: 250px;
  object-fit: cover;
}

/* Scanning frame overlay */
.scanner-overlay-frame {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 70%;
  height: 50%;
  pointer-events: none;
}

.scanner-corner {
  position: absolute;
  width: 24px;
  height: 24px;
  border-color: #43e97b;
  border-style: solid;
}

.scanner-corner.top-left {
  top: 0; left: 0;
  border-width: 3px 0 0 3px;
  border-radius: 4px 0 0 0;
}

.scanner-corner.top-right {
  top: 0; right: 0;
  border-width: 3px 3px 0 0;
  border-radius: 0 4px 0 0;
}

.scanner-corner.bottom-left {
  bottom: 0; left: 0;
  border-width: 0 0 3px 3px;
  border-radius: 0 0 0 4px;
}

.scanner-corner.bottom-right {
  bottom: 0; right: 0;
  border-width: 0 3px 3px 0;
  border-radius: 0 0 4px 0;
}

.scanner-line {
  position: absolute;
  top: 0;
  left: 5%;
  width: 90%;
  height: 2px;
  background: linear-gradient(90deg, transparent, #43e97b, transparent);
  animation: scanLine 2s ease-in-out infinite;
}

@keyframes scanLine {
  0%, 100% { top: 10%; }
  50% { top: 90%; }
}

.scanner-hint {
  position: absolute;
  bottom: 12px;
  left: 0;
  width: 100%;
  text-align: center;
  color: #fff;
  font-size: 0.85rem;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  margin: 0;
}

/* Success */
.scanner-success {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 16px;
  background: #ecfdf5;
  border: 1px solid #a7f3d0;
  border-radius: 10px;
  margin-bottom: 16px;
}

.scanner-success .success-icon {
  font-size: 1.4rem;
}

.scanner-success p {
  margin: 0;
  font-size: 0.9rem;
  color: #065f46;
}

.scanner-success strong {
  font-family: 'Courier New', Courier, monospace;
  font-size: 1rem;
}

/* Manual entry */
.scanner-manual {
  border-top: 1px solid #e5e7eb;
  padding-top: 16px;
}

.manual-label {
  margin: 0 0 10px;
  font-size: 0.85rem;
  color: #6b7280;
}

.manual-form {
  display: flex;
  gap: 8px;
}

.manual-input {
  flex: 1;
  padding: 10px 14px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  font-size: 0.95rem;
  transition: border-color 0.2s;
  outline: none;
}

.manual-input:focus {
  border-color: #667eea;
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
}

.btn-manual-submit {
  padding: 10px 16px;
  background: #667eea;
  color: #fff;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-size: 0.9rem;
  white-space: nowrap;
  transition: background 0.2s;
}

.btn-manual-submit:hover:not(:disabled) {
  background: #5a6fd6;
}

.btn-manual-submit:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ── Footer ── */
.scanner-footer {
  padding: 12px 20px 16px;
  display: flex;
  justify-content: center;
}

.btn-cancel-scanner {
  padding: 10px 30px;
  background: #f3f4f6;
  color: #374151;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  cursor: pointer;
  font-size: 0.9rem;
  transition: all 0.2s;
}

.btn-cancel-scanner:hover {
  background: #e5e7eb;
}

/* ── Scanner button in parent ── */
.btn-scanner {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 18px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-size: 0.9rem;
  font-weight: 500;
  transition: all 0.2s;
  box-shadow: 0 2px 8px rgba(102, 126, 234, 0.3);
}

.btn-scanner:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(102, 126, 234, 0.4);
}

.btn-scanner:active {
  transform: translateY(0);
}

/* ── Responsive ── */
@media (max-width: 520px) {
  .barcode-scanner-modal {
    width: 100%;
    max-width: 100%;
    max-height: 100vh;
    border-radius: 0;
    height: 100%;
  }

  .scanner-header {
    border-radius: 0;
  }

  .scanner-video {
    min-height: 300px;
  }

  .manual-form {
    flex-direction: column;
  }
}

/* ══════════════════════════════════════════════
