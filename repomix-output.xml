  }
};

exports.createIncident = async (req, res) => {
  try {
    const associationId = getAssociationId(req);
    const { vehicleId, description, status } = req.body;

    if (!vehicleId || !description) {
      return res.status(400).json({
        success: false,
        message: 'Vehicule et description requis'
      });
    }

    const vehicle = await TransportVehicle.findOne({ _id: vehicleId, association: associationId });
    if (!vehicle) {
      return res.status(404).json({
        success: false,
        message: 'Vehicule non trouve'
      });
    }

    const incident = await VehicleIncident.create({
      association: associationId,
      vehicle: vehicleId,
      description,
      status: status || 'en_cours',
      createdBy: req.user._id
    });

    res.status(201).json({
      success: true,
      data: incident
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: error.message
    });
  }
};

exports.updateIncident = async (req, res) => {
  try {
    const associationId = getAssociationId(req);
    const { description, status } = req.body;

    const incident = await VehicleIncident.findOne({
      _id: req.params.id,
      association: associationId
    });

    if (!incident) {
      return res.status(404).json({
        success: false,
        message: 'Incident non trouve'
      });
    }

    if (description !== undefined) incident.description = description;
    if (status !== undefined) incident.status = status;

    await incident.save();

    res.json({
      success: true,
      data: incident
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: error.message
    });
  }
};

exports.resolveIncident = async (req, res) => {
  try {
    const associationId = getAssociationId(req);
    const incident = await VehicleIncident.findOne({
      _id: req.params.id,
      association: associationId
    });

    if (!incident) {
      return res.status(404).json({
        success: false,
        message: 'Incident non trouve'
      });
    }

    incident.status = 'resolu';
    incident.resolvedAt = new Date();
    await incident.save();

    res.json({
      success: true,
      data: incident
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: error.message
    });
  }
};

exports.deleteIncident = async (req, res) => {
  try {
    const associationId = getAssociationId(req);
    const incident = await VehicleIncident.findOne({
      _id: req.params.id,
      association: associationId
    });

    if (!incident) {
      return res.status(404).json({
        success: false,
        message: 'Incident non trouve'
      });
    }

    await incident.deleteOne();

    res.json({
      success: true,
      message: 'Incident supprime'
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: error.message
    });
  }
};
