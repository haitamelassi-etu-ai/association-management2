.status-badge.inactif { background: #ffebee; color: #c62828; }
.status-badge.en_attente { background: #fff8e1; color: #f57f17; }
.tasks-view .volunteer-tasks { background: white; border-radius: 12px; padding: 20px; margin-bottom: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
