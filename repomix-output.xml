/* Variables CSS - Professional Modern Design */
:root {
  /* Primary Colors - Sophisticated Palette */
  --color-primary: #2c3e50;
  --color-primary-light: #34495e;
  --color-primary-dark: #1a252f;
  
  --color-secondary: #3498db;
  --color-secondary-light: #5dade2;
