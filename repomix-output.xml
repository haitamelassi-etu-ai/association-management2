                <div className="modal-actions">
                  <button type="button" className="btn-secondary" onClick={() => setShowTaskModal(false)}>Annuler</button>
                  <button type="submit" className="btn-primary">Assigner</button>
                </div>
              </form>
            </div>
          </div>
        )}
      </div>
    </ProfessionalLayout>
  );
};

