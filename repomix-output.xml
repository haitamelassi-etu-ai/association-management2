.btn-submit:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
}

.btn-submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(50px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* RTL Support */
[dir='rtl'] .meal-message {
  border-left: none;
  border-right: 4px solid;
}

[dir='rtl'] .meal-card.served {
  border-left: none;
  border-right: 4px solid #4caf50;
}

[dir='rtl'] .meal-card.pending {
  border-left: none;
  border-right: 4px solid #ff9800;
}

/* Dark Mode */
[data-theme='dark'] .meal-message.success {
  background: linear-gradient(135deg, #1b5e20 0%, #2e7d32 100%);
  color: #a5d6a7;
}

[data-theme='dark'] .meal-message.error {
  background: linear-gradient(135deg, #b71c1c 0%, #c62828 100%);
  color: #ef9a9a;
}

[data-theme='dark'] .special-diet {
  background: #3e2723;
  color: #ffb74d;
}

[data-theme='dark'] .served-info {
  background: #1b5e20;
}

[data-theme='dark'] .served-info small {
  color: #a5d6a7;
}

/* Responsive */
@media (max-width: 768px) {
  .meal-distribution {
    padding: 1rem;
  }

  .meal-header {
    flex-direction: column;
    align-items: stretch;
  }

  .meal-header-actions {
    flex-direction: column;
  }

  .meal-stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .meals-grid {
    grid-template-columns: 1fr;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .modal-actions {
    flex-direction: column;
  }

  .btn-cancel, .btn-submit {
    width: 100%;
  }
}
</file>

