  margin-bottom: 0.3rem;
}

.footer-val {
  display: block;
  font-size: 1.8rem;
  font-weight: 800;
}

/* ── Loading & Error ── */
.analytics-loading,
.analytics-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  text-align: center;
}

.spinner {
  width: 50px;
  height: 50px;
  border: 4px solid #e2e8f0;
  border-top: 4px solid #0ea5e9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 1rem;
}

.analytics-error p {
  color: #ef4444;
  font-size: 1.1rem;
  margin-bottom: 1rem;
}

.btn-retry {
  padding: 0.7rem 1.8rem;
  background: #0ea5e9;
  color: white;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-size: 0.95rem;
  font-weight: 600;
  transition: all 0.3s ease;
}

.btn-retry:hover {
  background: #0284c7;
  transform: translateY(-2px);
}

/* ── Animations ── */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(15px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* recharts responsive fix */
.recharts-wrapper {
  font-size: 12px !important;
}

/* ── Responsive ── */
@media (max-width: 1200px) {
  .kpi-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 1024px) {
  .charts-row {
    grid-template-columns: 1fr;
  }
  .chart-card.chart-narrow,
  .chart-card.chart-wide {
    grid-column: span 1;
  }
}

@media (max-width: 768px) {
  .analytics-dashboard {
    padding: 1rem;
  }

  .header-title h1 {
    font-size: 1.3rem;
  }

  .kpi-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .kpi-card {
    padding: 0.9rem;
  }

  .kpi-icon {
    font-size: 1.8rem;
    width: 40px;
    height: 40px;
  }

  .kpi-value {
    font-size: 1.5rem;
  }

  .analytics-tabs {
    gap: 0.3rem;
  }

  .tab-btn {
    padding: 0.5rem 0.8rem;
    font-size: 0.8rem;
  }

  .tab-label {
    display: none;
  }

  .tab-icon {
    font-size: 1.3rem;
  }

  .chart-card {
    padding: 1rem;
  }

  .analytics-footer {
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem;
  }

  .footer-val {
    font-size: 1.4rem;
  }

  .data-cards-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 480px) {
  .kpi-grid {
    grid-template-columns: 1fr;
  }

  .analytics-footer {
    flex-direction: column;
  }
}

/* ── Print Section Title ── */
.print-section-title {
  font-size: 1.3rem;
  color: #1e293b;
  font-weight: 800;
  margin: 2rem 0 0.75rem;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid #e2e8f0;
  page-break-before: always;
}

.print-section-title:first-of-type {
  page-break-before: auto;
}

/* ── Tab Panel ── */
.tab-content {
  position: relative;
}

.tab-panel {
  animation: fadeIn 0.3s ease;
}

/* Print section titles only visible in print */
.print-section-title {
  display: none;
}

/* Print mode on screen: show loading indicator */
.analytics-dashboard.print-mode .header-actions-analytics {
  opacity: 0.5;
  pointer-events: none;
}

/* ═══════════════════════════════════════════
   Print Styles
   ═══════════════════════════════════════════ */
@media print {
  /* Reset page */
  * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; color-adjust: exact !important; }

  @page {
    size: A4 landscape;
    margin: 12mm 10mm;
  }

  /* Hide non-printable elements */
  .no-print,
  .dashboard-sidebar,
  .mobile-menu-toggle,
  .sidebar-overlay,
  .analytics-tabs,
  .btn-refresh,
  .btn-print,
  .header-actions-analytics,
  .btn-retry,
  nav, header:not(.analytics-header) {
    display: none !important;
  }

  /* Show ALL tab panels in print — they are already rendered by printMode */
  .tab-panel {
    page-break-inside: avoid;
  }

  /* Show section titles in print */
  .print-section-title {
    display: block !important;
    font-size: 1.1rem;
    color: #1e293b;
    font-weight: 800;
    margin: 1.5rem 0 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid #e2e8f0;
    page-break-before: always;
    page-break-after: avoid;
  }

  .tab-panel:first-child .print-section-title {
    page-break-before: avoid;
    margin-top: 0.5rem;
  }

  /* Full width */
  .dashboard-main {
    margin-left: 0 !important;
    padding: 0 !important;
    max-width: 100% !important;
    width: 100% !important;
  }

  .analytics-dashboard {
    padding: 0;
    max-width: 100%;
  }

  /* Header for print */
  .analytics-header {
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #1e293b;
    page-break-after: avoid;
  }

  .header-title h1 { font-size: 1.4rem; }
  .header-subtitle { font-size: 0.8rem; }

  /* KPI Cards */
  .kpi-grid {
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    page-break-after: avoid;
  }

  .kpi-card {
    padding: 0.6rem;
    border-radius: 6px;
    box-shadow: none;
    border: 1px solid #e2e8f0;
  }

  .kpi-icon { font-size: 1.2rem; width: 32px; height: 32px; }
  .kpi-value { font-size: 1.3rem; }
  .kpi-label { font-size: 0.7rem; }

  /* Print section titles */
  .print-section-title {
    font-size: 1.1rem;
    margin: 1rem 0 0.5rem;
    page-break-before: always;
    page-break-after: avoid;
  }

  .print-section-title:first-of-type {
    page-break-before: avoid;
  }

  /* Charts */
  .charts-section { page-break-inside: avoid; }

  .charts-row {
    page-break-inside: avoid;
    margin-bottom: 0.75rem;
  }

  .chart-card {
    box-shadow: none;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.75rem;
    page-break-inside: avoid;
  }

  .chart-header h3 { font-size: 0.9rem; }
  .chart-badge { font-size: 0.65rem; }

  /* Legend */
  .chart-legend-list { gap: 0.2rem; }
  .legend-item { font-size: 0.72rem; padding: 0.2rem 0.4rem; }
  .legend-dot { width: 8px; height: 8px; }

  /* Data tables */
  .data-table { font-size: 0.78rem; }
  .data-table th, .data-table td { padding: 0.3rem 0.5rem; }

  /* Data stat cards */
  .data-cards-grid { gap: 0.5rem; }
  .data-stat-card { padding: 0.5rem; }
  .data-stat-val { font-size: 1.3rem; }
  .data-stat-name { font-size: 0.72rem; }

  /* Footer */
  .analytics-footer {
    margin-top: 0.5rem;
    padding: 0.5rem;
    page-break-before: avoid;
    box-shadow: none;
    border: 1px solid #e2e8f0;
  }

  .footer-val { font-size: 1.1rem; }
  .footer-label { font-size: 0.7rem; }

  /* Tooltip hidden in print */
  .analytics-tooltip,
  .recharts-tooltip-wrapper { display: none !important; }

  /* Recharts SVG sizing */
  .recharts-wrapper,
  .recharts-surface {
    max-width: 100% !important;
  }
}

/* ═══════════════════════════
   AI Report Modal
   ═══════════════════════════ */
.ai-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: fadeIn 0.25s ease;
}

.ai-modal {
  background: white;
  border-radius: 16px;
  width: 90%;
  max-width: 760px;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.25);
  animation: modalSlideUp 0.35s ease;
}

@keyframes modalSlideUp {
  from { opacity: 0; transform: translateY(30px); }
  to   { opacity: 1; transform: translateY(0); }
}

.ai-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid #e5e7eb;
}

.ai-modal-header h2 {
  margin: 0;
  font-size: 1.25rem;
  color: #111827;
}

.ai-modal-close {
  background: none;
  border: none;
  font-size: 1.4rem;
  cursor: pointer;
  color: #6b7280;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}

.ai-modal-close:hover {
  background: #f3f4f6;
  color: #111827;
}

.ai-modal-body {
  padding: 1.5rem;
  overflow-y: auto;
  flex: 1;
}

.ai-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 3rem 1rem;
  gap: 1rem;
}

.ai-spinner {
  width: 48px;
  height: 48px;
  border: 4px solid #e5e7eb;
  border-top: 4px solid #10b981;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.ai-loading p {
  margin: 0;
  color: #374151;
  font-weight: 600;
  font-size: 1rem;
}

.ai-loading-sub {
  color: #9ca3af !important;
  font-weight: 400 !important;
  font-size: 0.85rem !important;
}

.ai-report-content {
  line-height: 1.75;
  color: #374151;
  font-size: 0.95rem;
}

.ai-report-content h3 {
  font-size: 1.15rem;
  color: #059669;
  margin: 1.2rem 0 0.5rem;
  border-bottom: 2px solid #d1fae5;
  padding-bottom: 0.3rem;
}

.ai-report-content h4 {
  font-size: 1.05rem;
  color: #111827;
  margin: 1rem 0 0.4rem;
}

.ai-report-content p {
  margin: 0.3rem 0;
}

.ai-report-content li {
  margin: 0.25rem 0 0.25rem 1.2rem;
  list-style: disc;
}

.ai-modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 0.75rem;
  padding: 1rem 1.5rem;
  border-top: 1px solid #e5e7eb;
}

.btn-ai-pdf {
  padding: 0.6rem 1.2rem;
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: white;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  font-size: 0.9rem;
  transition: all 0.2s;
}

.btn-ai-pdf:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
}

.btn-ai-copy {
  padding: 0.6rem 1.2rem;
  background: linear-gradient(135deg, #6366f1, #4f46e5);
  color: white;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  font-size: 0.9rem;
  transition: all 0.2s;
}

.btn-ai-copy:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
}

@media (max-width: 768px) {
  .ai-modal { width: 95%; max-height: 90vh; }
  .ai-modal-body { padding: 1rem; }
}
