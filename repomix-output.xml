  background: var(--card-bg);
  border-radius: 12px;
  margin-bottom: 2rem;
  border: 2px solid var(--border-color);
  flex-wrap: wrap;
}

.date-inputs {
  display: flex;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.date-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.date-group label {
  font-weight: 600;
  color: var(--text-color);
  font-size: 0.95rem;
}

.date-group input {
  padding: 0.75rem 1rem;
  border: 2px solid var(--border-color);
  border-radius: 8px;
  background: var(--bg-color);
  color: var(--text-color);
  font-size: 1rem;
  transition: all 0.3s ease;
}

.date-group input:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.btn-export {
  padding: 0.75rem 2rem;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  white-space: nowrap;
}

.btn-export:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
}

/* Loading */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rem 2rem;
  gap: 1rem;
}

.spinner {
  width: 50px;
  height: 50px;
  border: 4px solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Report Content */
.report-content {
  animation: fadeIn 0.5s ease;
}

/* Stats Overview */
.advanced-reports .stats-overview {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.advanced-reports .stat-box {
  background: var(--card-bg);
  padding: 2rem;
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 1.5rem;
  border: 2px solid var(--border-color);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.advanced-reports .stat-box:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
}

.advanced-reports .stat-box.blue { border-color: #667eea; }
.advanced-reports .stat-box.green { border-color: #4ade80; }
.advanced-reports .stat-box.orange { border-color: #fbbf24; }
.advanced-reports .stat-box.purple { border-color: #a78bfa; }

.advanced-reports .stat-icon {
  font-size: 3rem;
}

.advanced-reports .stat-value {
  font-size: 2.5rem;
  font-weight: bold;
  color: var(--primary-color);
}

.advanced-reports .stat-label {
  color: var(--text-secondary);
  font-size: 0.95rem;
  margin-top: 0.25rem;
}

/* Financial Summary */
.financial-summary {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  margin-bottom: 2rem;
}

.summary-card {
  background: var(--card-bg);
  padding: 2rem;
  border-radius: 12px;
  border: 2px solid var(--border-color);
}

.summary-card h3 {
  color: var(--primary-color);
  margin-bottom: 1.5rem;
  font-size: 1.3rem;
}

.summary-items {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem;
  background: var(--bg-color);
  border-radius: 8px;
  transition: all 0.3s ease;
}

.summary-item:hover {
  background: var(--border-color);
  transform: translateX(5px);
}

.summary-item span {
  color: var(--text-secondary);
  font-size: 0.95rem;
}

.summary-item strong {
  color: var(--primary-color);
  font-size: 1.2rem;
}

.summary-item.total {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border: 2px solid var(--primary-color);
  padding: 1.25rem 1rem;
}

.summary-item.total strong {
  font-size: 1.5rem;
}

/* Services Overview */
.services-overview {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.overview-card {
  background: var(--card-bg);
  padding: 2rem;
  border-radius: 12px;
  border: 2px solid var(--border-color);
}

.overview-card h3 {
  color: var(--primary-color);
  margin-bottom: 1.5rem;
  font-size: 1.3rem;
}

.overview-stats {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--border-color);
}

.stat-item:last-child {
  border-bottom: none;
}

.stat-item span {
  color: var(--text-secondary);
}

.stat-item strong {
  color: var(--text-color);
  font-size: 1.3rem;
}

.stat-item strong.green { color: #4ade80; }
.stat-item strong.orange { color: #fbbf24; }
.stat-item strong.blue { color: #667eea; }

/* Charts */
.charts-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
  gap: 2rem;
  margin-bottom: 2rem;
}

.chart-card {
  background: var(--card-bg);
  padding: 2rem;
  border-radius: 12px;
  border: 2px solid var(--border-color);
}

.chart-card.full-width {
  grid-column: 1 / -1;
}

.chart-card h3 {
  color: var(--primary-color);
  margin-bottom: 1.5rem;
  font-size: 1.3rem;
}

/* Animations */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* RTL Support */
[dir='rtl'] .report-message {
  border-left: none;
  border-right: 4px solid;
}

[dir='rtl'] .summary-item:hover {
  transform: translateX(-5px);
}

/* Dark Mode */
[data-theme='dark'] .report-message.success {
  background: linear-gradient(135deg, #1b5e20 0%, #2e7d32 100%);
  color: #a5d6a7;
}

[data-theme='dark'] .report-message.error {
  background: linear-gradient(135deg, #b71c1c 0%, #c62828 100%);
  color: #ef9a9a;
}

/* Responsive */
@media (max-width: 1024px) {
  .charts-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .advanced-reports {
    padding: 1rem;
  }

  .reports-header h2 {
    font-size: 2rem;
  }

  .report-tabs {
    gap: 0.5rem;
  }

  .tab {
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
  }

  .date-range-selector {
    flex-direction: column;
    align-items: stretch;
  }

  .date-inputs {
    flex-direction: column;
  }

  .btn-export {
    width: 100%;
  }

  .advanced-reports .stats-overview {
    grid-template-columns: 1fr;
  }

  .advanced-reports .stat-box {
    padding: 1.5rem;
  }

  .financial-summary,
  .services-overview {
    grid-template-columns: 1fr;
  }

  .charts-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 480px) {
  .advanced-reports .stat-icon {
    font-size: 2rem;
  }

  .advanced-reports .stat-value {
    font-size: 2rem;
  }

  .summary-item strong {
    font-size: 1rem;
  }
}
</file>

