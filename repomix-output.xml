}

.login-subtitle {
  margin: 0;
  color: rgba(37, 35, 31, 0.68);
  font-size: 0.98rem;
  line-height: 1.65;
}

.login-form {
  display: grid;
  gap: 18px;
}

.login-field {
  display: grid;
  gap: 8px;
}

.login-field-label {
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--login-charcoal);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.login-field-control {
  position: relative;
  display: flex;
  align-items: center;
  border: 1px solid var(--login-border);
  border-radius: 8px;
  background: #ffffff;
  transition: border-color 200ms ease, box-shadow 200ms ease, background 200ms ease;
}

.login-field-control:focus-within {
  border-color: var(--login-gold);
  box-shadow: 0 0 0 4px rgba(202, 162, 74, 0.18);
  background: #fffdf8;
}

.login-field-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 50px;
  color: rgba(37, 35, 31, 0.42);
  flex-shrink: 0;
}

.login-field-control:focus-within .login-field-icon {
  color: var(--login-gold);
}

.login-field-control input {
  flex: 1;
  min-width: 0;
  height: 50px;
  padding: 0 14px 0 0;
  border: 0;
  background: transparent;
  color: var(--login-charcoal);
  font-size: 0.98rem;
  outline: none;
}

.login-field-control input::placeholder {
  color: rgba(37, 35, 31, 0.34);
}

.login-field-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 50px;
  border: 0;
  background: transparent;
  color: rgba(37, 35, 31, 0.5);
  cursor: pointer;
  transition: color 180ms ease;
}

.login-field-toggle:hover {
  color: var(--login-charcoal);
}

.login-error {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  border-left: 3px solid #b82920;
  border-radius: 6px;
  background: rgba(184, 41, 32, 0.08);
  color: #7a1a14;
  font-size: 0.92rem;
  font-weight: 600;
}

.login-submit {
  position: relative;
  overflow: hidden;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  min-height: 52px;
  margin-top: 6px;
  padding: 0 22px;
  border: 1px solid transparent;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--login-gold) 0%, var(--login-gold-soft) 60%, var(--login-gold) 100%);
  color: #211b0d;
  font-weight: 700;
  font-size: 0.98rem;
  letter-spacing: 0.02em;
  cursor: pointer;
  box-shadow: 0 14px 28px rgba(202, 162, 74, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.45);
  transition: box-shadow 240ms ease, opacity 240ms ease;
}

.login-submit::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, transparent 30%, rgba(255, 255, 255, 0.55) 50%, transparent 70%);
  transform: translateX(-120%);
  transition: transform 760ms ease;
  pointer-events: none;
}

.login-submit:hover::before {
